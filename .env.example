# Al Maktab Al Aqari — Environment Variables
# Copy this file to `.env.local` and fill in your values.
# The platform runs in fully-functional "Demo Mode" without any of these
# variables (in-memory data + simulated auth) so you can explore the UI.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL + anon key from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key — used ONLY by `supabase/seed.ts`.
# NEVER expose it to the browser or put it in client components.
SUPABASE_SERVICE_ROLE_KEY=

# ── Maps ────────────────────────────────────────────────────────────────────
# Public Mapbox token (optional — the app falls back to a raster tile layer)
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Next.js ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://realestatemaktab.vercel.app
NEXT_PUBLIC_SITE_NAME=Al Maktab Al Aqari
NEXT_PUBLIC_SITE_NAME_AR=المكتب العقاري

# ── WhatsApp (optional override; falls back to company settings) ────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=971501234567
