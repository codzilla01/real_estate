# ============================================================
#  Al Maktab — Admin Auth Server configuration
#  Copy this file to `.env` and fill in real values.
#  NEVER commit the real `.env` file.
# ============================================================

# Server
PORT=3000
NODE_ENV=production

# Public URL of this server (used for CORS + cookie domain)
PUBLIC_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API.
# Put your deployed site URL here, e.g. https://almaktab.ae
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500

# Secret used to sign session tokens (JWT-like HMAC).
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Set to "true" when serving over HTTPS so cookies get the Secure flag.
# (If you terminate TLS in front of this server, keep it true.)
SECURE_COOKIES=false

# Who may embed the site in a frame (clickjacking protection).
# "'none'"  = nobody may embed it (recommended for production)
# "'self'"  = allow same-origin embedding (needed for iframe previews)
FRAME_ANCESTORS='none'

# ============================================================
#  ADMIN ACCOUNTS — username + password
# ============================================================
#  Generate a password hash with:
#     npm run hash-password -- "your password" --env ADMIN1_PASSWORD_HASH
#
#  Use *_PASSWORD_HASH (Argon2id) whenever possible.
#  *_PASSWORD (plaintext) also works but is weaker — the server warns at startup.
# ============================================================

# --- Admin #1 ---
ADMIN1_USERNAME=admin
ADMIN1_PASSWORD_HASH=
# ADMIN1_PASSWORD=            # plaintext fallback (avoid if possible)
ADMIN1_NAME=Dev
ADMIN1_FULL_NAME=Mr. Developer
ADMIN1_ROLE=المسؤول الرئيسي
ADMIN1_AVATAR=D
ADMIN1_PERMISSIONS=all

# --- Admin #2 ---
ADMIN2_USERNAME=manager
ADMIN2_PASSWORD_HASH=
# ADMIN2_PASSWORD=
ADMIN2_NAME=مهند
ADMIN2_FULL_NAME=مهند عبد الخالق - مالك المكتب العقاري
ADMIN2_ROLE=المسؤول الثاني
ADMIN2_AVATAR=م
ADMIN2_PERMISSIONS=all

# --- Admin #3 (optional) ---
# ADMIN3_USERNAME=
# ADMIN3_PASSWORD_HASH=
# ADMIN3_NAME=
# ADMIN3_FULL_NAME=
# ADMIN3_ROLE=مشرف
# ADMIN3_AVATAR=
# ADMIN3_PERMISSIONS=properties

# ============================================================
#  CLIENT ACCOUNTS — optional
#  If none are configured, the public site skips customer login.
# ============================================================
# CLIENT1_USERNAME=client
# CLIENT1_PASSWORD_HASH=
# CLIENT1_FULL_NAME=محمد الأحمد
# CLIENT1_PHONE=971501234567

# ============================================================
#  TELEGRAM — optional, for security alerts only
#  These are NOT used for authentication (that is username + password).
# ============================================================

# Bot that receives login-success / failed-attempt notifications
ADMIN1_BOT_TOKEN=
ADMIN1_CHAT_ID=
ADMIN2_BOT_TOKEN=
ADMIN2_CHAT_ID=

# Optional: a dedicated bot/channel for security events
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# ============================================================
#  LOGIN THROTTLING
# ============================================================
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_SECONDS=900
MAX_LOGIN_REQUESTS_PER_WINDOW=10
LOGIN_WINDOW_SECONDS=600
SESSION_TTL_SECONDS=28800
