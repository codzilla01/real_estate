# ============================================================
#  Al Maktab — Admin Auth Server configuration
#  Copy this file to `.env` and fill in real values.
#  NEVER commit the real `.env` file.
# ============================================================

# Server
PORT=3000
NODE_ENV=production

# Public URL of this server (used for CORS + cookie domain)
PUBLIC_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API.
# Put your deployed site URL here, e.g. https://almaktab.ae
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500

# Secret used to sign session tokens (JWT-like HMAC).
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Set to "true" when serving over HTTPS so cookies get the Secure flag.
# (If you terminate TLS in front of this server, keep it true.)
SECURE_COOKIES=false

# ============================================================
#  Telegram bots
#  One bot token + chat id per admin. Tokens live ONLY here.
# ============================================================

# Admin #1
ADMIN1_NAME=Dev
ADMIN1_FULL_NAME=Mr. Developer
ADMIN1_ROLE=المسؤول الرئيسي
ADMIN1_AVATAR=D
ADMIN1_BOT_TOKEN=
ADMIN1_CHAT_ID=
ADMIN1_PERMISSIONS=all

# Admin #2
ADMIN2_NAME=مهند
ADMIN2_FULL_NAME=مهند عبد الخالق - مالك المكتب العقاري
ADMIN2_ROLE=المسؤول الثاني
ADMIN2_AVATAR=م
ADMIN2_BOT_TOKEN=
ADMIN2_CHAT_ID=
ADMIN2_PERMISSIONS=all

# Optional: a bot used only to notify you of security events
# (failed logins, rate-limit blocks, new admin attempts).
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=
