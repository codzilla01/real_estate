# ============================================================
# المكتب العقاري — إعدادات الخادم
# انسخ هذا الملف إلى server/.env وعدّل القيم:
#   cp .env.example .env
# ولا ترفع .env إلى Git أبداً (هو مستثنى في .gitignore).
# ============================================================

# --- عام ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# سر توقيع كوكي الجلسة (HMAC-SHA256).
# اتركه فارغاً في التطوير ليُولَّد مؤقتاً، أو ولّد واحداً ثابتاً:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# مدة الجلسة بالساعات (افتراضي 8)
SESSION_TTL_HOURS=8

# حماية التخمين: عدد المحاولات قبل الحظر + مدة الحظر بالدقائق
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# سياسة frame-ancestors (علّمها 'none' لمنع التضمين في مواقع أخرى)
FRAME_ANCESTORS='none'

# --- حسابات المسؤولين ---
# حتى 9 حسابات: ADMIN1_* .. ADMIN9_*
# ولّد هاش كلمة المرور بـ Argon2id:
#   npm run hash-password -- "YourPassword123!" --env ADMIN1_PASSWORD_HASH
ADMIN1_USERNAME=admin
ADMIN1_NAME=مدير النظام
ADMIN1_FULL_NAME=مدير النظام الرئيسي
ADMIN1_ROLE=مسؤول رئيسي
ADMIN1_PERMISSIONS=all
ADMIN1_AVATAR=👑
ADMIN1_PASSWORD_HASH=

# إشعارات تيليجرام اختيارية (لبوت ينتمي للمسؤول)
ADMIN1_BOT_TOKEN=
ADMIN1_CHAT_ID=

# --- حسابات العملاء (اختيارية) ---
# إذا لم تُعرّف أي حساب عميل، يعمل تسجيل دخول العملاء بحسابات المسؤولين نفسها.
# CLIENT1_USERNAME=client
# CLIENT1_NAME=عميل
# CLIENT1_FULL_NAME=عميل تجريبي
# CLIENT1_AVATAR=👤
# CLIENT1_PASSWORD_HASH=
